# Copy this file to ".env" and fill in your key LATER.
# Leave LLM_API_KEY empty => the app runs in DEMO (mock) mode.

LLM_API_KEY=
# anthropic  or  openai  (openai also works with any OpenAI-compatible server)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Only needed for openai-compatible providers, e.g. https://api.openai.com/v1
LLM_BASE_URL=

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
